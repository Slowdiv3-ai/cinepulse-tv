<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video Renderer (Audio permanently muted at 0f) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing" />

    <!-- CinePulse Real-Time DSP Overlay -->
    <LinearLayout
        android:id="@+id/dspControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC10141D"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1: Stream URL Input & Load Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStreamUrl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#222838"
                android:hint="Paste direct movie URL (.mp4 / .mkv / .m3u8)"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8892A6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLoadUrl"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:focusable="true"
                android:text="Play"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 2: Cinematic Modes -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeOff"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:focusable="true"
                    android:text="OFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeAction"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:text="ACTION"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeHorror"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:text="HORROR"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeThriller"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:text="THRILLER"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:text="VOLUME"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:text="FREQUENCY"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 3: Frequency Presets (Shown when Frequency/Action/Horror active) -->
        <LinearLayout
            android:id="@+id/freqPresetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPresetBass"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:focusable="true"
                android:text="LOW BASS"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPresetHeli"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:text="HELICOPTER"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPresetHigh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:text="HIGH"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 4: Speed (lfoFreq) & Intensity (depth) Sliders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpeedLabel"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:text="Speed: 0.5Hz"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:max="190"
                android:progress="40" />

            <TextView
                android:id="@+id/tvDepthLabel"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Depth: 50%"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekDepth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
